# Dev quick-login tokens for Login.tsx
#
# Copy this file to .env.development.local (gitignored) and fill in your
# own bearer tokens. Vite injects these at build time (DEV mode only).
# Buttons only appear in the UI when the variable is non-empty.
#
# Get tokens from:
#   - Admin:    ADMIN_PASSWORD env var / backend seed output
#   - Agents:   ~/.jarwis/tokens.json  (per-role actor tokens)
#
# NEVER commit .env.development.local — it is gitignored.

VITE_DEV_TOKEN_ADMIN=change-me-on-first-login
VITE_DEV_TOKEN_PM=
VITE_DEV_TOKEN_ARCHITECT=
VITE_DEV_TOKEN_BACKEND=
VITE_DEV_TOKEN_FRONTEND=
VITE_DEV_TOKEN_REVIEWER=
VITE_DEV_TOKEN_QA=
