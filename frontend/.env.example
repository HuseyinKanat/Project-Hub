# ProjectHub frontend env vars
#
# These values are read by Vite at build time (`import.meta.env.VITE_*`).
# That means the value is baked into the JS bundle — overriding for production
# requires either (a) a separate `.env.production` file, (b) a CI substitution
# step before `npm run build`, or (c) a Docker build arg.

# REST API base URL — used by frontend/src/api/client.ts for /api and /mcp calls.
# In Docker dev mode this is the host-mapped backend port (NOT container-internal `backend:8000`).
VITE_API_URL=http://localhost:8000

# WebSocket base URL — used by frontend/src/hooks/useWebSocket.ts.
# Set explicitly to bypass Vite 5.x's broken WebSocket proxy (ECONNRESET on every browser upgrade).
# Browser connects DIRECTLY to backend; Vite is NOT in the WS path.
#
# Host-vs-container ports: the browser runs on the host machine and reaches backend via the
# docker-compose port-map (`8000:8000`), so use `localhost:8000`, NOT `backend:8000`.
#
# Production: change scheme + host. Example: `wss://api.your-domain.com`. The `ws://` scheme
# WILL be blocked by browsers under HTTPS (mixed-content); use `wss://` over TLS in prod.
VITE_WS_URL=ws://localhost:8000
