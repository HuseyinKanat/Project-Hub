# ProjectHub frontend env vars
#
# These values are read by Vite at build time (`import.meta.env.VITE_*`) and baked
# into the JS bundle. Overriding for production requires either (a) a separate
# `.env.production` file, (b) a CI substitution step before `npm run build`, or
# (c) a Docker build arg.
#
# +-- IMPORTANT (PH-324) -------------------------------------------------------+
# | For LAN / multi-user (remote) access, LEAVE BOTH VARS EMPTY / UNSET.        |
# | The app then derives URLs from window.location.host (host-relative), so it  |
# | works from any client — localhost, a `.local` mDNS name, or a changing LAN  |
# | IP. Setting either to `localhost` hard-codes the developer's own machine    |
# | and BREAKS every remote browser. Vite proxies /api, /mcp and /ws to the     |
# | backend (see vite.config.ts).                                               |
# +----------------------------------------------------------------------------+

# REST API base URL — OPTIONAL. Consumed by frontend/src/api/client.ts.
# Leave UNSET: client.ts uses BASE="/api" (host-relative) regardless of this var,
# so it has no runtime effect in dev; kept only for documentation / future use.
# VITE_API_URL=

# WebSocket base URL — OPTIONAL override. Consumed by frontend/src/hooks/useWebSocket.ts.
# Leave UNSET (default): the hook falls back to `${wsProtocol}//${window.location.host}`
# (host-relative) and the browser's WS is forwarded by Vite's `/ws` proxy to the backend.
# Set ONLY for production over TLS, e.g. `wss://api.your-domain.com`. Under HTTPS a plain
# `ws://` URL is blocked by browsers (mixed-content) — always use `wss://` in prod.
# VITE_WS_URL=
