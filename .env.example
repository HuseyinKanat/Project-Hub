# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=projecthub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Admin bootstrap (used only on first run) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_DISPLAY_NAME=Admin

# --- GitHub integration ---
GITHUB_PAT=ghp_xxxxx
# Webhook secrets are per-board, generated and stored in DB

# --- MCP / Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS allowlist (comma-separated). Tailscale or local IPs.
# IMPORTANT: must include http://localhost:<FRONTEND_PORT> for browser WebSocket connections
# to work when VITE_WS_URL is set to ws://localhost:8000 (direct backend bypass).
# Starlette CORSMiddleware intercepts WS upgrade requests and rejects Origins not in this list.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://100.64.0.1:5173

# --- Security ---
SECRET_KEY=generate-a-random-string-here
TOKEN_HASH_ROUNDS=12

# --- Git integration (G2 read-only mount) ---
# PH-228: PROJECTS_ROOT now defaults to the whole host ${HOME} (was a single
# project-hub sub-path). The backend mounts it read-only at /repos so EVERY board's
# repos_path is visible. Override only for CI / alternate layouts:
# PROJECTS_ROOT=/abs/path/to/home  # backend read-only mount root; default: ${HOME}
# PH-228: HOST_HOME is the host $HOME that the mount maps onto /repos. Boards store
# HOST paths (Board.repos_path); the translation helper swaps this prefix for /repos.
# Must equal whatever ${HOME} resolved to at mount time. Default: /Users/huseyinkanat
# HOST_HOME=/Users/huseyinkanat

# --- SonarQube integration (PH-191) — stack boots fine with ENABLED=false ---
# HOST PREREQUISITE before `docker compose up -d sonarqube-db sonarqube`:
#   vm.max_map_count >= 262144 (embedded Elasticsearch). macOS/Docker Desktop:
#     docker run --rm --privileged alpine sysctl -w vm.max_map_count=262144
#   (see docker-compose.yml sonarqube comment + PH-197 runbook for the full sequence)
SONARQUBE_ENABLED=false
# Compose-internal URL used BY the backend poller (PH-193) and the scanner CONTAINER
# (PH-194) — resolves only inside the compose network.
SONARQUBE_URL=http://sonarqube:9000
# User token from the one-time bootstrap (My Account → Security → Generate Tokens →
# User Token). NEVER commit a real token — this placeholder stays empty; the real
# value lives only in the gitignored .env.
SONARQUBE_TOKEN=
SONARQUBE_POLLING_INTERVAL_SECONDS=300
# JSON map of board key -> SonarQube projectKey. PH-194 CONSISTENCY CONTRACT:
# this value for "PH" MUST equal sonar.projectKey in sonar-project.properties
# (project-hub) so the scanner write and the PH-193 poller read agree.
SONARQUBE_PROJECT_KEY_MAP={"PH":"project-hub"}
SONARQUBE_PORT=9000
# PH-194: HOST-reachable probe URL for scripts/sonar-scan.sh's reachability check
# (the merge-to-main scan runs on the host, where sonarqube:9000 does NOT resolve —
# the published port does). Defaults to http://localhost:${SONARQUBE_PORT}.
SONAR_SCAN_URL=http://localhost:9000
# SonarQube's own dedicated Postgres (separate container/volume; change creds for non-dev)
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube
SONARQUBE_DB_NAME=sonarqube
