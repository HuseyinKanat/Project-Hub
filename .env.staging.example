# .env.staging.example — PH-333 (ISOLATED staging clone)
#
# Copy to `.env.staging` (gitignored) and use with the staging compose override:
#   cp .env.staging.example .env.staging   # then edit if you like; defaults work
#
# This file is loaded via `env_file: !override [".env.staging"]` in
# docker-compose.staging.yml, which REPLACES (not merges) the base `env_file: .env`.
# Therefore it MUST be COMPLETE — it carries every runtime var the staging backend /
# frontend / postgres containers need. It contains ZERO real secret material: distinct
# staging SECRET_KEY, synthetic admin creds, and EMPTY placeholders for GITHUB_PAT /
# SONARQUBE_TOKEN — so the staging instance never replicates a live credential.

# --- Application ---
APP_ENV=staging
LOG_LEVEL=INFO

# --- Database (staging-only creds; distinct DB name; separate namespaced volume) ---
POSTGRES_USER=projecthub
POSTGRES_PASSWORD=staging-only-changeme
POSTGRES_DB=projecthub_staging
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Admin bootstrap (SYNTHETIC — consumed by `python -m app.cli bootstrap`) ---
# ADMIN_PASSWORD is also the admin actor's initial bearer token (see bootstrap output).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=staging-admin-changeme
ADMIN_DISPLAY_NAME=Admin

# --- GitHub integration (EMPTY on staging — no live PAT) ---
GITHUB_PAT=

# --- MCP / Server (ALTERNATE host ports — avoid live 8000 / 5174 and sonar 9000) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8020
FRONTEND_PORT=5183

# CORS allowlist — staging frontend origin only.
CORS_ALLOWED_ORIGINS=http://localhost:5183

# --- Security (DISTINCT from live — never copy the live SECRET_KEY here) ---
SECRET_KEY=staging-only-not-a-secret-change-me
TOKEN_HASH_ROUNDS=12

# --- SonarQube integration — DISABLED + excluded on staging ---
SONARQUBE_ENABLED=false
SONARQUBE_URL=http://sonarqube:9000
SONARQUBE_TOKEN=
SONARQUBE_POLLING_INTERVAL_SECONDS=300
SONARQUBE_PROJECT_KEY_MAP={"PH":"project-hub"}
SONARQUBE_PORT=9000
SONAR_SCAN_URL=http://localhost:9000
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube
SONARQUBE_DB_NAME=sonarqube
